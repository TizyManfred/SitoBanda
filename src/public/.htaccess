# SitoBanda Public Directory - Apache Configuration File

# Set the default charset
AddDefaultCharset UTF-8

# Disable directory browsing
Options -Indexes

# Set default index files
DirectoryIndex index.php index.html

# Simple PHP to HTML fallback (if PHP file doesn't exist, try HTML)
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Rule 1: Handle gallery album URLs
    # This handles requests like /gallery-album/follonica-maggio -> /gallery-album.php?slug=follonica-maggio
    RewriteRule ^gallery-album/([^/]+)/?$ gallery-album.php?slug=$1 [L,QSA]
    
    # Rule 2: If example.php exists, serve it for request "example"
    # This handles requests like /chi-siamo -> /chi-siamo.php
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([^\.]+)$ $1.php [L]               # Rewrite to example.php

    # Rule 3: If example.php does not exist, but example.html exists, serve it for "example"
    # This handles requests like /somepage -> /somepage.html if /somepage.php doesn't exist
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php !-f
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^([^\.]+)$ $1.html [L]              # Rewrite to example.html
</IfModule>

# Basic performance settings
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
